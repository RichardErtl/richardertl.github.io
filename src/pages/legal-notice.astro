---
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base title="Legal notice" noindex>
  <main id="main" class="in stub">
    <h1>Legal notice</h1>
    <p>Disclosure under § 25 of the Austrian Media Act (Offenlegung gemäß § 25 MedienG)</p>
    <dl class="legal">
      <dt>Media owner (Medieninhaber)</dt>
      <dd>{site.name}, Linz, Austria</dd>
      <dt>Contact</dt>
      <dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
      <dt>Basic direction (grundlegende Richtung)</dt>
      <dd>Personal portfolio and engineering journal on software engineering with AI agents.</dd>
    </dl>
    <p>This is a private, non-commercial website. It carries no advertising and offers no paid services.</p>
  </main>
</Base>
