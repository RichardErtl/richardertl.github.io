---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/newsreader/standard-italic.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import { isPublicBuild, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'articles' | 'projects' | 'about';
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date | undefined;
  updatedAt?: Date | undefined;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  current,
  image = '/social/default.png',
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);

const nav = [
  { key: 'home', href: '/', label: 'Home' },
  { key: 'articles', href: '/articles/', label: 'Articles' },
  { key: 'projects', href: '/projects/', label: 'Projects' },
  { key: 'about', href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {(!isPublicBuild || noindex) && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0E3B43" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: engineering journal`} href="/rss.xml" />
    {isPublicBuild && <link rel="sitemap" href="/sitemap-index.xml" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? site.headline} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="in">
      <header class="top">
        <a class="brand" href="/">{site.name}</a>
        <nav aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>
    </div>
    <slot />
    <footer class="foot">
      <div class="in">
        <p>{site.name}</p>
        <p class="fl">
          <a href={site.links.github}>GitHub</a>
          <a href={site.links.linkedin}>LinkedIn</a>
          <a href="/legal-notice/">Legal notice</a>
          <a href="/privacy/">Privacy</a>
        </p>
      </div>
    </footer>
  </body>
</html>
